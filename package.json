{
  "name": "dsh-auto-preset",
  "version": "0.1.0",
  "description": "DSH plugin: remember your last manual permission-preset choice per session and restore it when the session is reopened.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "permission",
    "auto-review"
  ],
  "author": "heyuanliu3-byte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyuanliu3-byte/dsh-auto-preset.git"
  },
  "homepage": "https://github.com/heyuanliu3-byte/dsh-auto-preset#readme",
  "bugs": {
    "url": "https://github.com/heyuanliu3-byte/dsh-auto-preset/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
